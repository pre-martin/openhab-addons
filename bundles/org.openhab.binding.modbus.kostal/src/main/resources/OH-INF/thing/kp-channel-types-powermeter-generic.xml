<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="modbus"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-type id="kp-cos-phi-pm-type">
		<item-type>Number:Dimensionless</item-type>
		<label>Powermeter Cos Phi</label>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="kp-frequency-pm-type">
		<item-type>Number:Frequency</item-type>
		<label>Powermeter Frequency</label>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="kp-total-active-power-pm-type">
		<item-type>Number:Power</item-type>
		<label>Powermeter Total Active Power</label>
		<category>Energy</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="kp-total-reactive-power-pm-type">
		<item-type>Number:Power</item-type>
		<label>Powermeter Total Reactive Power</label>
		<category>Energy</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="kp-total-apparent-power-pm-type">
		<item-type>Number:Power</item-type>
		<label>Powermeter Total Apparent Power</label>
		<category>Energy</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

</thing:thing-descriptions>
