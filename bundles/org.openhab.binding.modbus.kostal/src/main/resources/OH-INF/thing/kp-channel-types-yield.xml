		<category>Energy</category>
		<state readOnly="true" pattern="%.3f %unit%"/>
	</channel-type>

	<channel-type id="kp-yearly-yield-type">
		<item-type>Number:Energy</item-type>
		<label>Yearly Yield</label>
		<category>Energy</category>
		<state readOnly="true" pattern="%.3f %unit%"/>
	</channel-type>

</thing:thing-descriptions>
